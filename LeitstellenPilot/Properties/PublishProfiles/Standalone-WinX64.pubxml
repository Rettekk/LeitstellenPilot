<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <FileVersion Condition="'$(ReleaseVersion)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy.M.d.HHmm'))</FileVersion>
    <FileVersion Condition="'$(ReleaseVersion)' != ''">$(ReleaseVersion)</FileVersion>
    <AssemblyVersion>$(FileVersion)</AssemblyVersion>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>$(MSBuildProjectDirectory)\..\publish\standalone-win-x64\</PublishDir>
    <PublishUrl>$(PublishDir)</PublishUrl>
  </PropertyGroup>
</Project>
